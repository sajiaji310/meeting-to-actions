# OpenAI-compatible chat completions API.
# Leave OPENAI_API_KEY empty to use the built-in offline extraction
# for the bundled sample transcript only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Speech-to-text. Uses the same key and base URL as chat when the
# TRANSCRIPTION_* values are empty. Leave every key empty and uploads
# fail with an explicit message; the app will not invent a transcript.
# Chinese is the default language. OpenAI: gpt-4o-mini-transcribe.
# Groq and other Whisper hosts: set TRANSCRIPTION_MODEL=whisper-large-v3
# or whisper-1, and point TRANSCRIPTION_BASE_URL at that host if needed.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=zh

# Google Calendar OAuth. Leave these empty to keep demo mode:
# review and .ics export still work, and nothing is written to Google.
# Redirect URI must match the Google Cloud OAuth client exactly.
# Local:  http://127.0.0.1:3847/api/auth/google/callback
# Vercel: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3847/api/auth/google/callback

# Encrypts the calendar session cookie. Required only for Google OAuth.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public site origin, no trailing slash. On Vercel set this to
# https://<your-domain> so OAuth returns to the public https host.
# Local default is the request host (http://127.0.0.1:3847 with npm run dev).
APP_BASE_URL=

# Optional upload cap in bytes. Leave unset: local runs allow 25MB,
# and Vercel automatically uses 4MB so the request stays under the
# platform's 4.5MB serverless body limit. Values above 25MB are clamped.
# AUDIO_MAX_BYTES=4194304
